# Federated AML Network — copy to `.env`.
# No external secrets needed. Tune the federated run + privacy budget here.

NUM_ROUNDS=3
MIN_CLIENTS=3

# Differential privacy (Opacus DP-SGD on each client).
# DP_ENABLED=true clips + noises per-sample gradients; EPSILON is the target
# privacy budget for the whole run, reported back on :8200/metrics.
# Set DP_ENABLED=false for the vanilla (no-privacy) baseline.
DP_ENABLED=true
EPSILON=5.0
